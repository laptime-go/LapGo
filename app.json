{
  "expo": {
    "name": "圈速Go",
    "slug": "lapgo",
    "version": "1.0.26",
    "orientation": "portrait",
    "owner": "fungfung1984",
    "icon": "./icon.png",
    "scheme": "lapgo",
    "splash": {
      "image": "./splash-icon.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.lapgo.timer",
      "versionCode": 26,
      "permissions": ["ACCESS_FINE_LOCATION","ACCESS_COARSE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      ["expo-build-properties", {
        "android": {"kotlinVersion": "1.9.22"}
      }]
    ],
    "extra": { "eas": { "projectId": "55a685d0-0488-4232-8159-54c692861118" } }
  }
}
