{
  "expo": {
    "name": "圈速Go",
    "slug": "lapgo",
    "version": "1.0.27",
    "orientation": "portrait",
    "owner": "fungfung1984",
    "icon": "./icon.png",
    "scheme": "lapgo",
    "splash": { "image": "./splash-icon.png", "backgroundColor": "#ffffff", "resizeMode": "contain" },
    "android": {
      "package": "com.lapgo.timer",
      "versionCode": 30,
      "permissions": ["ACCESS_FINE_LOCATION","ACCESS_COARSE_LOCATION","INTERNET"],
      "adaptiveIcon": { "foregroundImage": "./adaptive-icon.png", "backgroundColor": "#ffffff" },
      "config": { "googleMaps": { "apiKey": "" } }
    },
    "plugins": [
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "需要定位先可以自動計圈" }],
      ["react-native-maps", { "androidGoogleMapsApiKey": "" }],
      ["react-native-google-mobile-ads", { "androidAppId": "ca-app-pub-9890149028563226~9678218420" }],
      ["expo-build-properties", { "android": { "compileSdkVersion": 34, "targetSdkVersion": 34, "kotlinVersion": "1.9.22" } }]
    ],
    "extra": { "eas": { "projectId": "55a685d0-0488-4232-8159-54c692861118" } }
  }
}
