{
  "expo": {
    "name": "LapTime Go",
    "slug": "laptime-go-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.jpg",
    "userInterfaceStyle": "dark",
    "owner": "fungfung1984",
    "splash": {
      "image": "./splash-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lapgo.timer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.jpg",
        "backgroundColor": "#121212"
      },
      "package": "com.lapgo.timer"
    },
    "web": { "favicon": "./favicon.jpg" },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": { "minSdkVersion": 24, "compileSdkVersion": 34, "targetSdkVersion": 34, "kotlinVersion": "1.9.25" },
          "ios": { "deploymentTarget": "15.1" }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow LapTime Go to use location to auto-detect track and lap timing.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9890149028563226~9678218420",
          "iosAppId": "ca-app-pub-9890149028563226~9678218420",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "075ddfb4-4fc5-47dd-acd4-d398b1319a94"
      }
    }
  }
}
