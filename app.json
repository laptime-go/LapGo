{
  "expo": {
    "name": "LapTime Go",
    "slug": "laptime-go",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./icon.jpg",
    "userInterfaceStyle": "dark",
    "owner": "fungfung84",
    "splash": {
      "image": "./splash-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lapgo.timer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.jpg",
        "backgroundColor": "#121212"
      },
      "package": "com.lapgo.timer",
      "versionCode": 2,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "com.android.vending.BILLING"
      ]
    },
    "web": { "favicon": "./favicon.jpg" },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": { "minSdkVersion": 23, "compileSdkVersion": 34, "targetSdkVersion": 34 }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow LapTime Go to use location to auto-detect track and lap timing.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9890149028563226~9678218420",
          "iosAppId": "ca-app-pub-9890149028563226~9678218420"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0c8d52dd-8886-408d-bfae-f803101d8a09"
      }
    }
  }
}
