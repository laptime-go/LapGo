{
  "expo": {
    "name": "圈速Go",
    "slug": "laptime-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "splash": { "image": "./splash-icon.png", "resizeMode": "contain", "backgroundColor": "#000000" },
    "android": {
      "package": "com.laptimego.app",
      "adaptiveIcon": { "foregroundImage": "./adaptive-icon.png", "backgroundColor": "#000000" },
      "config": { "googleMobileAdsAppId": "ca-app-pub-9890149028563226~9678218420" },
      "permissions": ["ACCESS_FINE_LOCATION","ACCESS_COARSE_LOCATION","ACCESS_BACKGROUND_LOCATION"]
    },
    "ios": { "bundleIdentifier": "com.laptimego.app", "config": { "googleMobileAdsAppId": "ca-app-pub-9890149028563226~9678218420" } },
    "plugins": [
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "允許圈速Go使用GPS記錄圈速", "isAndroidBackgroundLocationEnabled": true, "isAndroidForegroundServiceEnabled": true }]
    ]
  }
}
