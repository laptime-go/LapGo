{
  "expo": {
    "name": "LapTime Go",
    "slug": "lapgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "owner": "fungfung1984",
    "splash": {
      "image": "./splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laptimego.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.laptimego.app"
    },
    "web": {
      "favicon": "./favicon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9890149028563226~9678218420",
          "iosAppId": "ca-app-pub-9890149028563226~9678218420"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "55a685d0-0488-4232-8159-54c692861118"
      }
    },
    "cli": {
      "appVersionSource": "remote"
    }
  }
}
