{
  "expo": {
    "name": "LapTime Go",
    "slug": "lapgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "owner": "fungfung84",
    "splash": {
      "image": "./splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lapgo.timer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.lapgo.timer"
    },
    "web": { "favicon": "./favicon.png" },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": { "minSdkVersion": 23, "compileSdkVersion": 34, "targetSdkVersion": 34 }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow LapTime Go to use location to auto-detect track and lap timing.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9890149028563226~9678218420",
          "iosAppId": "ca-app-pub-9890149028563226~9678218420",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3485a81a-4f67-4c6c-b49a-ea6a3ea1ac80"
      }
    }
  }
}
